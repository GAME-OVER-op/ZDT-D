<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.android.zdtd.service" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="ZDT-D TGWS Plugin"
        android:supportsRtl="true">

        <!-- Headless component: intentionally no MAIN/LAUNCHER activity. -->
        <service
            android:name=".TgWsPluginService"
            android:exported="true"
            android:permission="com.android.zdtd.service.plugin.com.permission.CONTROL_TGWS">
            <intent-filter>
                <action android:name="com.android.zdtd.service.plugin.com.action.BIND_TGWS" />
            </intent-filter>
        </service>
    </application>

</manifest>
